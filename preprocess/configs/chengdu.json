{
  "city": "chengdu",
  "folder": "chengdu",
  "input": {
    "path": "chengdu_trips.csv",
    "row_filter": null,
    "id_col": "TRIP_ID",
    "start_col": "TIMESTAMP",
    "poly_col": "POLYLINE",
    "point_ts_col": "point_ts",
    "tt_col": "trip_travel_time_s",
    "interval_s": null,
    "min_trip_time_s": null,
    "max_trip_time_s": 10800,
    "keep_cols": [
      "entity_id",
      "traj_id"
    ]
  },
  "trip_id": {
    "hash": false,
    "on_duplicate": "drop"
  },
  "area": {
    "pbf": "sichuan-260131.osm.pbf",
    "load_bbox": null,
    "boundary_query": {
      "boundary_type": "administrative",
      "custom_filter": {
        "admin_level": [
          "4",
          "5",
          "6",
          "7",
          "8",
          "9",
          "10"
        ]
      },
      "extra_attributes": [
        "name:en",
        "name:zh",
        "name:zh-Hans",
        "name:zh-Hant",
        "official_name",
        "alt_name",
        "short_name",
        "wikidata",
        "wikipedia"
      ]
    },
    "name_cols": [
      "name",
      "name:en",
      "name:zh",
      "name:zh-Hans",
      "name:zh-Hant",
      "official_name",
      "alt_name",
      "short_name"
    ],
    "name_regex": "(?iu)(chengdu|成都|成都市)",
    "name_match": "contains",
    "admin_levels": [
      "4",
      "5",
      "6",
      "7",
      "8",
      "9",
      "10"
    ],
    "fallback": "nearest_large",
    "fallback_center": [
      104.06,
      30.67
    ],
    "select": "union_largest_part",
    "metric_epsg": 32648,
    "buffer_m": 100,
    "single_polygon": true,
    "min_vertices": 50,
    "coord_sys": "GCJ02",
    "swap_margin_deg": 0.001045,
    "bbox_margin_deg": 0.001045,
    "prefilter_margin_deg": 0.001045,
    "touch_ok": true,
    "centre_box": {
      "half_size_km": 10.0,
      "margin_m": 100,
      "median_of": "input"
    }
  },
  "buckets": {
    "width_min": 15,
    "max_min": 180,
    "seed": 42,
    "mode": "all"
  },
  "visual": {
    "tiles": "OpenStreetMap",
    "tiles_attr": null,
    "heatmap_on": "area",
    "metric_epsg": 32648,
    "step_m": 50,
    "max_points": 2000000,
    "radius": 8,
    "blur": 15,
    "zoom_start": 12,
    "tz": null
  },
  "network": {
    "network_type": "driving",
    "load_clip": "area",
    "filter": "intersects",
    "clip_box": null
  },
  "selection": {
    "min_trips": 1,
    "min_days": 28,
    "mean_minutes": [
      0,
      180
    ],
    "length_bands": [
      3,
      10,
      15,
      20,
      30,
      40,
      50,
      60
    ],
    "short_band_min_share": 0.0,
    "long_band_min_trips": 0,
    "trip_coverage_floor": 0.0,
    "coverage_min": 0
  },
  "map_matching": {
    "crs_metric": "EPSG:32648",
    "osrm_extract": "osrm/sichuan-260131.osrm",
    "osrm_url": "http://localhost:5006",
    "local_tz": null,
    "dyn_align": "departure",
    "workers_per_shard": 4,
    "slots": 18,
    "buf_m": 10.0,
    "radius_m": 25.0
  }
}
